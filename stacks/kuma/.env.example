# Kuma stack settings for the GCP e2-micro (location "gcp"). IPv6-only VM.
# On the VM: sudo cp .env.example .env && sudo chmod 600 .env && sudo nano .env
# .env holds secrets: it lives on the VM only, never in git, never in OpenTofu.
# docs/WHAT-YOU-DO.md says where each value comes from.

# --- Tailscale
TS_HOSTNAME=kuma-gcp
# Optional. Empty = log in once with the link from `sudo docker compose logs tailscale`.
TS_AUTHKEY=

# --- Which monitors this Kuma runs
KUMA_LOCATION=gcp
MONITOR_DIR=uptime-kuma/remote-monitors/gcp

# --- Kuma admin login (you create this account on the first visit; AutoKuma logs in with it)
KUMA_ADMIN_USER=
KUMA_ADMIN_PASSWORD=

# --- Git source: ANY git repository that holds AutoKuma monitor files (*.json / *.toml) under MONITOR_DIR.
# The stack checks it out every SYNC_PERIOD seconds over the tailnet (this VM has no IPv4, and github.com has no IPv6: use a mirror
# reachable over IPv6 or the tailnet). Use a READ-ONLY token. This is an optional integration of the original author's setup: without
# a repository like that, do not create .env and the stack never starts. Example:
#   GIT_URL=https://git.example.com/<your-user>/<your-monitors-repo>.git
GIT_URL=
GIT_BRANCH=main
GIT_USERNAME=
GIT_TOKEN=
# Seconds between git fetches (each costs a few KB of the 1 GB/month free egress).
SYNC_PERIOD=600

# --- Alerts (optional): up/down events are POSTed to a webhook of yours at <KUMA_WORKER_URL>/kuma/<location>
# with the header "Authorization: Bearer <KUMA_TOKEN>". Empty = monitors alert nobody (sync.sh says so in its log).
KUMA_WORKER_URL=
KUMA_TOKEN=
# Name of the notification AutoKuma creates; it must match notification_name_list in your monitor files.
KUMA_NOTIFICATION_NAME=worker

# --- Heartbeat (optional): the push URL of a "push" monitor in ANOTHER Uptime Kuma, called every PUSH_PERIOD seconds
# while the local Kuma answers. Empty = no heartbeat. It holds a token: keep it in this file only.
KUMA_PUSH_URL=
PUSH_PERIOD=60

# --- Images. This VM has no IPv4 and ghcr.io has no IPv6: AutoKuma comes from a ghcr.io pull-through cache
# reachable over the tailnet (the oracle-always-free repository runs one on micro-edge; GHCR_MIRROR is its tailnet address
# and port). Without such a cache, mirror the AutoKuma image to a registry that answers on IPv6 and set AUTOKUMA_IMAGE to it,
# with COMPOSE_PROFILES empty.
# Docker Hub images (Kuma, Tailscale, git, curl, socat) are pulled directly over IPv6.
AUTOKUMA_IMAGE=localhost:5000/bigboot/autokuma:2
COMPOSE_PROFILES=ghcr-mirror
GHCR_MIRROR=micro-edge:5000
# Other container images (defaults shown; put a version tag to pin one):
# TAILSCALE_IMAGE=tailscale/tailscale:latest
# KUMA_IMAGE=louislam/uptime-kuma:2
# GIT_IMAGE=alpine/git:latest
# CURL_IMAGE=curlimages/curl:latest
# SOCAT_IMAGE=alpine/socat:latest
